<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.1//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_2.dtd'>
<nta>
	<declaration>// Place global declarations here.

bool controlled;         // company is controlled by purchaser
bool paymentComplete;    // the debt has been paid back completely

int debt;  // amount of money that remains to be paid

const int price = 100;         // price of acquisition
const int installment = 40;    // amount regularly paid back
const int interest = 5;       // interest, here as a fixed amount to avoid computing with fractions (float)

// synchronization channels
chan requestPermission, grantPermission, refusePermission, 
    startAcquisition, endAcquisition,
    payment;
</declaration>
	<template>
		<name x="5" y="5">Company</name>
		<declaration>// Place local declarations here.</declaration>
		<location id="id0" x="-51" y="-110">
			<name x="-25" y="-119">independent</name>
		</location>
		<location id="id1" x="-51" y="-17">
			<name x="-25" y="-25">acquisitionInCourse</name>
		</location>
		<location id="id2" x="-51" y="68">
			<name x="-17" y="59">sold</name>
		</location>
		<init ref="id0"/>
		<transition>
			<source ref="id1"/>
			<target ref="id1"/>
			<label kind="synchronisation" x="-118" y="-46">payment?</label>
			<nail x="-136" y="-42"/>
			<nail x="-136" y="17"/>
		</transition>
		<transition>
			<source ref="id1"/>
			<target ref="id2"/>
			<label kind="synchronisation" x="-34" y="17">endAcquisition?</label>
		</transition>
		<transition>
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="synchronisation" x="-34" y="-76">startAcquisition?</label>
		</transition>
	</template>
	<template>
		<name>MAS</name>
		<location id="id3" x="-25" y="-85">
		</location>
		<location id="id4" x="-17" y="68">
		</location>
		<init ref="id3"/>
		<transition>
			<source ref="id4"/>
			<target ref="id3"/>
			<label kind="synchronisation" x="-59" y="-34">grantPermission!</label>
			<nail x="8" y="-8"/>
		</transition>
		<transition>
			<source ref="id3"/>
			<target ref="id4"/>
			<label kind="synchronisation" x="-221" y="-34">requestPermission?</label>
			<nail x="-102" y="-8"/>
		</transition>
		<transition>
			<source ref="id4"/>
			<target ref="id3"/>
			<label kind="synchronisation" x="76" y="-25">refusePermission!</label>
			<nail x="102" y="-42"/>
		</transition>
	</template>
	<template>
		<name>Purchaser</name>
		<location id="id5" x="-280" y="-697">
		</location>
		<location id="id6" x="-280" y="-612">
		</location>
		<location id="id7" x="-280" y="-544">
		</location>
		<location id="id8" x="-374" y="-586">
		</location>
		<location id="id9" x="-280" y="-365">
		</location>
		<location id="id10" x="-280" y="-450">
		</location>
		<location id="id11" x="-280" y="-272">
		</location>
		<init ref="id5"/>
		<transition>
			<source ref="id10"/>
			<target ref="id6"/>
			<label kind="guard" x="-238" y="-484">debt &gt; 0</label>
			<label kind="assignment" x="-195" y="-510">debt = debt + interest</label>
			<nail x="-170" y="-544"/>
		</transition>
		<transition>
			<source ref="id9"/>
			<target ref="id11"/>
			<label kind="synchronisation" x="-382" y="-331">endAcquisition!</label>
		</transition>
		<transition>
			<source ref="id10"/>
			<target ref="id9"/>
			<label kind="guard" x="-365" y="-425">debt &lt;= 0</label>
			<label kind="assignment" x="-425" y="-399">paymentComplete = 1</label>
		</transition>
		<transition>
			<source ref="id7"/>
			<target ref="id10"/>
			<label kind="synchronisation" x="-365" y="-535">payment!</label>
			<label kind="assignment" x="-433" y="-510">debt = debt - installment</label>
		</transition>
		<transition>
			<source ref="id8"/>
			<target ref="id7"/>
			<label kind="synchronisation" x="-356" y="-582">grantPermission?</label>
		</transition>
		<transition>
			<source ref="id6"/>
			<target ref="id8"/>
			<label kind="synchronisation" x="-416" y="-629">requestPermission!</label>
		</transition>
		<transition>
			<source ref="id5"/>
			<target ref="id6"/>
			<label kind="synchronisation" x="-255" y="-680">startAcquisition!</label>
			<label kind="assignment" x="-255" y="-654">controlled = 0, paymentComplete = 0, debt = price</label>
		</transition>
	</template>
	<system>// Place template instantiations here.
C = Company();
M = MAS();
P = Purchaser();
// List one or more processes to be composed into a system.
system C, M, P;</system>
	<queries>
		<query>
			<formula>E&lt;&gt; controlled</formula>
			<comment></comment>
		</query>
		<query>
			<formula>A&lt;&gt; controlled</formula>
			<comment></comment>
		</query>
		<query>
			<formula>A&lt;&gt; C.sold</formula>
			<comment></comment>
		</query>
		<query>
			<formula>E&lt;&gt; controlled and not paymentComplete
</formula>
			<comment></comment>
		</query>
		<query>
			<formula>E&lt;&gt; C.sold</formula>
			<comment></comment>
		</query>
	</queries>
</nta>
